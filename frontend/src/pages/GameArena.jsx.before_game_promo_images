import { useEffect, useMemo, useState } from 'react';
import { Link, Navigate } from 'react-router-dom';
import {
  Gamepad2,
  Play,
  ArrowRight,
  ShieldCheck,
  Trophy,
} from 'lucide-react';

import { gamesAPI, api } from '../lib/api';
import { GAME_MAP } from '../components/games';

export default function GameArena() {
  const [settings, setSettings] = useState(null);
  const [games, setGames] = useState([]);
  const [contests, setContests] = useState([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    Promise.all([
      api.get('/settings').then(r => r.data),
      gamesAPI.types(),
      api.get('/contests').then(r => r.data),
    ])
      .then(([publicSettings, gameResponse, contestResponse]) => {
        setSettings(publicSettings || {});
        setGames(gameResponse?.games || []);
        setContests(Array.isArray(contestResponse) ? contestResponse : []);
      })
      .catch(() => {})
      .finally(() => setLoading(false));
  }, []);

  const selectedGames = useMemo(() => {
    const selected = Array.isArray(settings?.game_preview_games)
      ? settings.game_preview_games
      : [];

    return games.filter(
      game => selected.includes(game.id) && GAME_MAP[game.id]
    );
  }, [games, settings]);

  const contestCountFor = (gameId) =>
    contests.filter(
      c =>
        c.game_type === gameId &&
        c.status === 'live'
    ).length;

  if (loading) {
    return (
      <div className="max-w-7xl mx-auto px-4 py-16 text-center text-slate-500">
        Loading games…
      </div>
    );
  }

  if (!settings?.game_preview_enabled) {
    return <Navigate to="/" replace />;
  }

  return (
    <div className="bg-slate-50 min-h-screen">
      <section className="bg-gradient-to-br from-slate-950 via-indigo-950 to-fuchsia-950 text-white">
        <div className="max-w-7xl mx-auto px-4 lg:px-8 py-14 md:py-20">
          <div className="max-w-3xl">
            <div className="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-[#FFD54A] font-extrabold">
              <Gamepad2 className="w-4 h-4" />
              Prize League Game Arena
            </div>

            <h1 className="font-display text-4xl md:text-6xl font-black mt-3 leading-tight">
              Try our skill games before you compete
            </h1>

            <p className="text-white/70 mt-4 text-base md:text-lg max-w-2xl">
              Play selected practice games free. Preview plays do not use
              tickets, do not affect leaderboards and do not create official
              competition scores.
            </p>

            <div className="mt-6 flex flex-wrap gap-3 text-sm">
              <span className="inline-flex items-center gap-2 bg-white/10 border border-white/10 rounded-full px-4 py-2">
                <ShieldCheck className="w-4 h-4 text-emerald-400" />
                No login required
              </span>

              <span className="inline-flex items-center gap-2 bg-white/10 border border-white/10 rounded-full px-4 py-2">
                <Trophy className="w-4 h-4 text-[#FFD54A]" />
                Practice only
              </span>
            </div>
          </div>
        </div>
      </section>

      <section className="max-w-7xl mx-auto px-4 lg:px-8 py-10 md:py-14">
        {selectedGames.length === 0 ? (
          <div className="bg-white rounded-2xl border border-slate-100 p-10 text-center">
            <Gamepad2 className="w-12 h-12 mx-auto text-slate-300" />
            <div className="font-display text-xl font-extrabold mt-3">
              No preview games are currently available
            </div>
            <p className="text-sm text-slate-500 mt-2">
              Please check back soon.
            </p>
          </div>
        ) : (
          <div className="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {selectedGames.map(game => {
              const contestCount = contestCountFor(game.id);

              return (
                <Link
                  key={game.id}
                  to={`/games/${game.id}`}
                  className="group bg-white border border-slate-100 rounded-2xl p-5 hover:shadow-xl hover:-translate-y-0.5 transition"
                  data-testid={`public-game-${game.id}`}
                >
                  <div className="w-12 h-12 rounded-xl bg-gradient-to-br from-[#6C2BFF] to-fuchsia-600 text-white flex items-center justify-center">
                    <Gamepad2 className="w-6 h-6" />
                  </div>

                  <h2 className="font-display font-extrabold text-xl text-slate-900 mt-4">
                    {game.label}
                  </h2>

                  <div className="mt-2 text-sm text-slate-500 capitalize">
                    {game.category} · Target {game.target_time_s}s
                  </div>

                  <div className="mt-4 flex items-center justify-between">
                    <div className="text-xs text-slate-500">
                      {contestCount > 0
                        ? `${contestCount} live contest${contestCount !== 1 ? 's' : ''}`
                        : 'Practice available'}
                    </div>

                    <div className="inline-flex items-center gap-1 text-[#6C2BFF] font-bold text-sm">
                      Play Free
                      <ArrowRight className="w-4 h-4" />
                    </div>
                  </div>
                </Link>
              );
            })}
          </div>
        )}
      </section>
    </div>
  );
}
